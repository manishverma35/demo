  <style>
    /* ==========================================================================
       CUSTOM EDITORIAL TOKENS, MICRO-INTERACTIONS & ACCESSIBLE MOTION
       ========================================================================== */
    :root {
      --bg-primary: #F4F1EA;
      --bg-elevated: #EBE6DC;
      --border-subtle: rgba(13, 14, 17, 0.12);
      --text-primary: #0D0E11;
      --text-muted: rgba(13, 14, 17, 0.68);
      --accent-vermilion: #E85D3F;
      --accent-sage: #5C7861;
    }

    html.dark {
      --bg-primary: #0D0E11;
      --bg-elevated: #15171C;
      --border-subtle: rgba(244, 241, 234, 0.11);
      --text-primary: #F4F1EA;
      --text-muted: rgba(244, 241, 234, 0.68);
      --accent-vermilion: #E85D3F;
      --accent-sage: #8FA893;
    }

    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      transition: background-color 0.35s ease, color 0.35s ease;
      overflow-x: hidden;
    }

    /* Subtle architectural paper grain overlay */
    .grain-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 45;
      opacity: 0.032;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    /* Staggered Kinetic Hero Reveal */
    @keyframes heroReveal {
      0% {
        opacity: 0;
        transform: translateY(28px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-stagger {
      opacity: 0;
      animation: heroReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .delay-1 { animation-delay: 0.08s; }
    .delay-2 { animation-delay: 0.18s; }
    .delay-3 { animation-delay: 0.28s; }
    .delay-4 { animation-delay: 0.38s; }

    /* IntersectionObserver Scroll Reveal Classes */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Custom Magnetic Cursor Follower (Desktop pointer devices only) */
    @media (hover: hover) and (pointer: fine) {
      #cursor-follower {
        position: fixed;
        top: 0;
        left: 0;
        width: 28px;
        height: 28px;
        border-radius: 9999px;
        border: 1.5px solid #E85D3F;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    height 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    background-color 0.25s ease,
                    border-color 0.25s ease;
        mix-blend-mode: normal;
      }
      #cursor-follower.is-hovering {
        width: 56px;
        height: 56px;
        background-color: rgba(232, 93, 63, 0.14);
        border-color: #E85D3F;
      }
    }

    /* Active Navigation Indicator */
    .nav-link.active {
      color: #E85D3F;
    }
    .nav-link.active::after {
      content: '';
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 9999px;
      background-color: #E85D3F;
      margin: 2px auto 0;
    }

    /* Modal Backdrop & Drawer Transition */
    .modal-backdrop {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-panel {
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-backdrop.open .modal-panel {
      transform: translateX(0);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(143, 168, 147, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #E85D3F;
    }

    /* Respect Reduced Motion Preferences */
    @media (prefers-reduced-motion: reduce) {
      .hero-stagger, .reveal-on-scroll {
        animation: none !important;
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      #cursor-follower {
        display: none !important;
      }
    }
  </style>
</head>
