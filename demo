  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ink: '#0D0E11',
            'ink-elevated': '#15171C',
            'ink-border': '#252830',
            alabaster: '#F4F1EA',
