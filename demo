         4. CAPABILITIES FILTER LOGIC
         ---------------------------------------------------------------------- */
      document.querySelectorAll('.skill-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.skillFilter;
          document.querySelectorAll('.skill-filter-btn').forEach((b) => {
            b.classList.remove('active', 'bg-vermilion', 'text-alabaster');
            b.classList.add('border', 'border-current/15');
          });
          btn.classList.add('active', 'bg-vermilion', 'text-alabaster');
          btn.classList.remove('border', 'border-current/15');

          document.querySelectorAll('.capability-card').forEach((card) => {
            if (filter === 'all' || card.dataset.skillGroup === filter) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });

      /* ----------------------------------------------------------------------
         5. THEME SWITCHER, HEADER SCROLL STATE & MOBILE DRAWER
         ---------------------------------------------------------------------- */
      const htmlEl = document.documentElement;
      const themeToggleBtn = document.getElementById('theme-toggle');
      const siteHeader = document.getElementById('site-header');
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileDrawer = document.getElementById('mobile-drawer');

      // Persist or respect saved preference (defaults to Ink Dark)
      const savedTheme = localStorage.getItem('av-theme');
      if (savedTheme === 'light') {
        htmlEl.classList.remove('dark');
      }

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const isDark = htmlEl.classList.toggle('dark');
          localStorage.setItem('av-theme', isDark ? 'dark' : 'light');
          showToast(isDark ? 'Switched to Ink Dark palette' : 'Switched to Editorial Alabaster palette');
        });
      }

      // Sticky header glassmorphism on scroll
      window.addEventListener('scroll', () => {
        if (window.scrollY > 24) {
          siteHeader.classList.add('bg-alabaster/85', 'dark:bg-ink/85', 'backdrop-blur-xl', 'border-current/10');
          siteHeader.classList.remove('border-transparent');
        } else {
          siteHeader.classList.remove('bg-alabaster/85', 'dark:bg-ink/85', 'backdrop-blur-xl', 'border-current/10');
          siteHeader.classList.add('border-transparent');
        }
      }, { passive: true });

      // Mobile Drawer Toggle
      if (mobileMenuBtn && mobileDrawer) {
        mobileMenuBtn.addEventListener('click', () => {
          const isOpen = !mobileDrawer.classList.contains('hidden');
          mobileDrawer.classList.toggle('hidden');
          mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
        });

        document.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.addEventListener('click', () => {
            mobileDrawer.classList.add('hidden');
            mobileMenuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      /* ----------------------------------------------------------------------
         6. ACTIVE SECTION HIGHLIGHTING & SCROLL REVEAL OBSERVER
         ---------------------------------------------------------------------- */
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal-on-scroll').forEach((el) => revealObserver.observe(el));

      // Active Nav Section Highlighting
      const sections = document.querySelectorAll('main section[id]');
      const navLinks = document.querySelectorAll('.nav-link');

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
            });
          }
        });
      }, { rootMargin: '-35% 0px -55% 0px' });

      sections.forEach((sec) => sectionObserver.observe(sec));

      /* ----------------------------------------------------------------------
         7. INTERACTIVE CONTACT FORM, SCOPE PILLS & CLIPBOARD COPY
         ---------------------------------------------------------------------- */
      const scopePills = document.querySelectorAll('.scope-pill');
      const selectedScopes = new Set(['Product UI/UX']);

      scopePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const scope = pill.dataset.scope;
          if (selectedScopes.has(scope)) {
            if (selectedScopes.size > 1) {
              selectedScopes.delete(scope);
              pill.classList.remove('active', 'bg-vermilion', 'text-alabaster', 'border-vermilion');
              pill.classList.add('border-current/20');
            }
          } else {
            selectedScopes.add(scope);
            pill.classList.add('active', 'bg-vermilion', 'text-alabaster', 'border-vermilion');
            pill.classList.remove('border-current/20');
          }
        });
      });

      // Real-time Validation & Submission
      const inquiryForm = document.getElementById('inquiry-form');
      const nameInput = document.getElementById('sender-name');
      const emailInput = document.getElementById('sender-email');
      const msgInput = document.getElementById('sender-message');

      function validateField(input, errorId, condition) {
        const errEl = document.getElementById(errorId);
        if (!condition) {
          errEl.classList.remove('hidden');
          input.classList.add('border-vermilion');
          return false;
        } else {
          errEl.classList.add('hidden');
          input.classList.remove('border-vermilion');
          return true;
        }
      }

      if (inquiryForm) {
        nameInput.addEventListener('input', () => validateField(nameInput, 'error-name', nameInput.value.trim().length >= 2));
        emailInput.addEventListener('input', () => validateField(emailInput, 'error-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())));
        msgInput.addEventListener('input', () => validateField(msgInput, 'error-message', msgInput.value.trim().length >= 15));

        inquiryForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const isNameValid = validateField(nameInput, 'error-name', nameInput.value.trim().length >= 2);
          const isEmailValid = validateField(emailInput, 'error-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim()));
          const isMsgValid = validateField(msgInput, 'error-message', msgInput.value.trim().length >= 15);

          if (!isNameValid || !isEmailValid || !isMsgValid) {
            showToast('Please check the highlighted form fields.');
            return;
          }

          const successBanner = document.getElementById('form-success-banner');
          const successDetail = document.getElementById('form-success-detail');
          successDetail.textContent = `Logged inquiry from ${nameInput.value.trim()} (${Array.from(selectedScopes).join(', ')}). Aarav will reply to ${emailInput.value.trim()} within 24h.`;
          successBanner.classList.remove('hidden');
          showToast('Project brief dispatched!');
          inquiryForm.reset();
        });
      }

      // Copy Email to Clipboard (iFrame-safe fallback using execCommand)
      const copyEmailBtn = document.getElementById('copy-email-btn');
      if (copyEmailBtn) {
        copyEmailBtn.addEventListener('click', () => {
          const email = 'hello@aaravverma.design';
          const tempInput = document.createElement('textarea');
          tempInput.value = email;
          tempInput.setAttribute('readonly', '');
          tempInput.style.position = 'absolute';
          tempInput.style.left = '-9999px';
          document.body.appendChild(tempInput);
          tempInput.select();
          try {
            document.execCommand('copy');
            copyEmailBtn.textContent = 'Copied!';
            showToast('Copied hello@aaravverma.design');
            setTimeout(() => { copyEmailBtn.textContent = 'Copy'; }, 2200);
          } catch (err) {
            showToast('Email: hello@aaravverma.design');
          }
          document.body.removeChild(tempInput);
        });
      }

      // Toast Notification Utility
      const toastEl = document.getElementById('toast-notification');
      const toastMsg = document.getElementById('toast-message');
      let toastTimeout;

      function showToast(message) {
        if (!toastEl || !toastMsg) return;
        toastMsg.textContent = message;
        toastEl.classList.remove('translate-y-20', 'opacity-0');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toastEl.classList.add('translate-y-20', 'opacity-0');
        }, 2800);
      }

      /* ----------------------------------------------------------------------
         8. LIVE NEW DELHI IST CLOCK & MAGNETIC CURSOR FOLLOWER
         ---------------------------------------------------------------------- */
      const delhiTimeEl = document.getElementById('live-delhi-time');
      function updateDelhiClock() {
        if (!delhiTimeEl) return;
        try {
          const formatted = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Asia/Kolkata',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
          }).format(new Date());
          delhiTimeEl.textContent = `IST ${formatted}`;
        } catch (e) {
          delhiTimeEl.textContent = 'IST UTC+5:30';
        }
      }
      updateDelhiClock();
      setInterval(updateDelhiClock, 1000);

      // Smooth Magnetic Cursor Follower
      const cursorFollower = document.getElementById('cursor-follower');
      let mouseX = -100, mouseY = -100, followerX = -100, followerY = -100;

      if (cursorFollower && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        }, { passive: true });

        function animateCursor() {
          followerX += (mouseX - followerX) * 0.18;
          followerY += (mouseY - followerY) * 0.18;
          cursorFollower.style.transform = `translate3d(${followerX}px, ${followerY}px, 0) translate(-50%, -50%)`;
          requestAnimationFrame(animateCursor);
        }
        requestAnimationFrame(animateCursor);
      }

      function bindMagneticTargets() {
        if (!cursorFollower) return;
        document.querySelectorAll('[data-magnetic]').forEach((el) => {
          el.addEventListener('mouseenter', () => cursorFollower.classList.add('is-hovering'));
          el.addEventListener('mouseleave', () => cursorFollower.classList.remove('is-hovering'));
        });
      }

      /* ----------------------------------------------------------------------
         9. INTERACTIVE HERO ARCHITECTURAL DOT-GRID CANVAS
         ---------------------------------------------------------------------- */
      const canvas = document.getElementById('hero-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = 0, height = 0;
        let pointer = { x: -9999, y: -9999 };

        function resizeCanvas() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const rect = canvas.parentElement.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          pointer.x = e.clientX - rect.left;
          pointer.y = e.clientY - rect.top;
        }, { passive: true });

        function drawArchitecturalGrid() {
          ctx.clearRect(0, 0, width, height);
          const isDark = htmlEl.classList.contains('dark');
          const spacing = 44;
          const radius = 170;

          for (let x = spacing / 2; x < width; x += spacing) {
            for (let y = spacing / 2; y < height; y += spacing) {
              const dx = pointer.x - x;
              const dy = pointer.y - y;
              const dist = Math.hypot(dx, dy);
              const influence = Math.max(0, 1 - dist / radius);

              const drawX = x - dx * influence * 0.14;
              const drawY = y - dy * influence * 0.14;
              const dotSize = 1.15 + influence * 2.3;

              ctx.beginPath();
              ctx.arc(drawX, drawY, dotSize, 0, Math.PI * 2);
              if (influence > 0.15) {
                ctx.fillStyle = `rgba(232, 93, 63, ${0.25 + influence * 0.65})`;
              } else {
                ctx.fillStyle = isDark ? 'rgba(244, 241, 234, 0.12)' : 'rgba(13, 14, 17, 0.13)';
              }
              ctx.fill();
            }
          }
          requestAnimationFrame(drawArchitecturalGrid);
        }

        window.addEventListener('load', () => {
          resizeCanvas();
          drawArchitecturalGrid();
        });
        resizeCanvas();
      }

      // Initialize dynamic sections on boot
      renderProjects('all');
      bindMagneticTargets();
    })();
  </script>
</body>
</html>
